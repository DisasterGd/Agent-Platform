APP_NAME=Agent Platform
APP_ENV=development
API_V1_PREFIX=/api
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DEV_USER_ID=1
DATABASE_URL=mysql+pymysql://agent_user:password@127.0.0.1:3306/agent_platform?charset=utf8mb4

# 大模型（OpenAI 兼容接口，默认 DeepSeek）
# LLM_PROVIDER 选择适配器：deepseek / openai_compatible（未来可加多模态模型）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.7

# 联网搜索：auto（默认，DuckDuckGo → Bing 网页兜底，零配置）| duckduckgo | bing_scrape | tavily | bing
# tavily / bing 需要 SEARCH_API_KEY
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5

# ============ v0.7 账号体系 ============
# 运行模式：local（默认，单用户免登录，行为与 v0.6 一致）| cloud（邮箱验证码登录、按用户隔离）
AUTH_MODE=local
# cloud 模式：首个管理员邮箱（该邮箱注册时自动获得管理员权限）；注册邀请码（留空=开放注册）
ADMIN_EMAIL=
INVITE_CODE=
# 登录会话有效期（天，滑动续期；cookie 名固定 ap_session）
SESSION_TTL_DAYS=30
# cloud 模式加密用户 API Key 的服务密钥（必配，随机长字符串；local 模式不使用——走 Windows DPAPI）
SERVICE_SECRET=

# 验证码邮件通道：console（默认，验证码打印到后端控制台，本地调试 cloud 模式用）| smtp
MAIL_PROVIDER=console
# SMTP 用 QQ/163 邮箱授权码即可（smtp.qq.com:465 / smtp.163.com:465，授权码不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
