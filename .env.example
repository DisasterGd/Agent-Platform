APP_NAME=Agent Platform
APP_ENV=development
API_V1_PREFIX=/api
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DEV_USER_ID=1
DATABASE_URL=mysql+pymysql://agent_user:password@127.0.0.1:3306/agent_platform?charset=utf8mb4

# 大模型（OpenAI 兼容接口，默认 DeepSeek）
# LLM_PROVIDER 选择适配器：deepseek / openai_compatible（未来可加多模态模型）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.7

# 联网搜索：auto（默认，DuckDuckGo → Bing 网页兜底，零配置）| duckduckgo | bing_scrape | tavily | bing
# tavily / bing 需要 SEARCH_API_KEY
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5

# ============ v0.7 账号体系 ============
# 运行模式：local（默认，单用户免登录，行为与 v0.6 一致）| cloud（邮箱验证码登录、按用户隔离）
AUTH_MODE=local
# cloud 模式：首个管理员邮箱（该邮箱注册时自动获得管理员权限）
ADMIN_EMAIL=
# 登录会话有效期（天，滑动续期；cookie 名固定 ap_session）
SESSION_TTL_DAYS=30
# cloud 模式加密用户 API Key 的服务密钥（必配，随机长字符串；local 模式不使用——走 Windows DPAPI）
SERVICE_SECRET=

# 验证码邮件通道：console（默认，验证码打印到后端控制台，本地调试用）| smtp
# v0.8.0 起推荐直接在 设置 → 平台 页签里配置（存 deployment_settings 表、立即生效、无需重启）；
# .env 里的以下值是逐字段兜底（界面没填的字段才生效）。上线（AUTH_MODE=cloud 对外服务）必须真实发信。
MAIL_PROVIDER=console
# SMTP 三步（QQ 邮箱为例）：
#   1. QQ 邮箱网页版 → 设置 → 账号 → 开启「IMAP/SMTP 服务」；
#   2. 按提示用手机发短信生成「授权码」（不是 QQ 登录密码）；
#   3. SMTP_HOST=smtp.qq.com SMTP_PORT=465 SMTP_USER=你的QQ邮箱 SMTP_PASSWORD=授权码 MAIL_FROM=你的QQ邮箱
# 163 邮箱同理（smtp.163.com:465）；到达率要求高再换专业邮件服务（在 mail/factory.py 加分支）。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ============ v0.8 云端部署（docker compose 用） ============
# MySQL 容器口令（compose 三件套用；与上面 DATABASE_URL 里的本地口令互不相干）
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 站点地址：有域名时设为你的域名（Caddy 自动签发 HTTPS 证书）；本地演练留空即 :80
SITE_ADDRESS=
# MySQL 连接池（worker × (pool_size + max_overflow) ≤ MySQL max_connections）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 全站 API 限流（每 IP 每分钟请求数；0=关闭）
RATE_LIMIT_PER_MINUTE=120
